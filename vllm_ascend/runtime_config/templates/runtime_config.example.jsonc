{
  // Runtime control plane (logging, detectors, incident actions).
  // Default path: <cwd>/runtime/config/runtime_config.json
  // Hot-reload: additional_config.runtime_config_reload_interval > 0
  // Comments and trailing commas are allowed (JSONC).

  "sync_mode": "broadcast",
  "reload_interval_seconds": 0,

  // Incident actions taken on any detector alert ("report" always available).
  "actions": {
    "defaults": {
      "on_trigger": ["report"]
    }
  },

  "ascend_log": {
    "level": "INFO",
    "debug": [],
    "modules": {}
  },

  "log": {
    "print_sampling_meta": false,
    "print_output_on_finish": false
  },

  "dump": {
    "auto_max_times": 0,
    "auto_cooldown_seconds": 300,
    "manual_dump": false,
    "dump_all_blocks": false
  },

  "report": {
    "save_sensitive_info": false,
    "decode_token_ids": true,
    "max_prompt_token_ids": 1000,
    "max_output_token_ids": 1000,
    "include_block_ids": true
  },

  "detector": {
    "stop_after_alert": true,
    "token_repeat": {
      "enabled": false,
      "window": 32,
      "repeat_sum_threshold": 64,
      "min_tokens": 32,
      "consecutive_hits": 1,
      "ignore_token_ids": []
    },
    "spec_acceptance": {
      "enabled": false,
      "window": 10,
      "low_threshold": 0.3,
      "len_low_threshold": 1.4,
      "high_threshold": 0.96,
      "len_high_threshold": 2.8
    },
    "token_logprob": {
      "enabled": false,
      "window": 64,
      "stride": 32,
      "topk": 20,
      "ill_nan_window_thresh": 1,
      "ill_rare_window_thresh": 1,
      "ill_garbled_window_thresh": 1,
      "ill_repet_window_thresh": 2
    },
    "output_substring": {
      "enabled": false,
      "patterns": [],
      "add_special_tokens": false,
      "match_prefix": false
    },
    "block_kv": {
      "enabled": false,
      "check_wave_regression": true,
      "check_same_wave_writer": true
    },
    "position_alignment": {
      "enabled": false
    },
    "logits_finite": {
      "enabled": false
    }
  }
}

{
  "reload_interval_seconds": 3,
  "dump": {
    "auto_max_times": 0,
    "manual_dump": true,
    "auto_cooldown_seconds": 60
  },
  "actions": {
    "defaults": {
      "on_trigger": ["report", "dump_kv"]
    }
  },
  "detector": {
    "logits_finite": { "enabled": false },
    "token_repeat": { "enabled": false },
    "output_substring": { "enabled": false },
    "spec_acceptance": { "enabled": false }
  }
}

{
  // Runtime control plane (logging, detectors, incident actions).
  // Default path: <cwd>/runtime/config/runtime_config.json
  // Hot-reload: additional_config.runtime_config_hot_reload=true (startup-only;
  // poll period is a fixed internal 3s — not exposed here).
  // Comments and trailing commas are allowed (JSONC).

  // Incident actions taken on any detector alert ("report" always available).
  // ActionQueue capacity is a fixed internal constant (not configurable here).
  "actions": {
    "defaults": {
      "on_trigger": ["report"]
    }
  },

  "ascend_log": {
    "level": "INFO",
    // Force SamplingMeta / runtime_guard DEBUG dumps, e.g. ["runtime_guard"].
    "debug": [],
    "modules": {}
  },

  "dump": {
    "auto_max_times": 0,
    "auto_cooldown_seconds": 300,
    // Prefer 1 (one shot). true / large N = continuous — not recommended.
    // false | true (continuous, discouraged) | N waves. In-memory -- per arm; JSON cleared only at 0.
    // Multi-DP one file: each DP may dump up to N times while file still shows N.
    "manual_dump": false
    // Free-space headroom for dump_kv is a fixed internal constant (5 GiB).
  },

  "report": {
    // When true, persist prompt/output token ids AND decode them to text.
    "save_sensitive_info": false,
    "max_prompt_token_ids": 1000,
    "max_output_token_ids": 1000,
    // Max JSON reports per (incident_type, req_id). Default 1.
    // Reaching the cap stops detection for that request (all detectors).
    // Keep "report" in on_trigger (default) so this path can fire.
    // GPU block_ids are always included in report detail.
    "max_per_req": 1
  },

  "detector": {
    "token_repeat": {
      "enabled": false,
      "window": 32,
      "repeat_sum_threshold": 64,
      "min_tokens": 32,
      "consecutive_hits": 1,
      "ignore_token_ids": []
    },
    "spec_acceptance": {
      "enabled": false,
      "window": 10,
      "low_threshold": 0.3,
      "len_low_threshold": 1.4,
      "high_threshold": 0.96,
      "len_high_threshold": 2.8
      // Per-req INFO short-log throttle is a fixed internal 2s.
    },
    "logits_finite": {
      "enabled": false,
      // Deferred alert-batch cap is a fixed internal constant.
      // false (default): async .item() — gate D2H overlaps sample/grammar; logits may
      // be mutated before wait (finite_kind can see post-grammar -inf). true: sync
      // .item() at pre-sample so gate + kind match pre-grammar logits.
      "item_sync": false
    },
    // Control-plane for dump.manual_dump / manual_trigger incidents.
    // dump_kv is always injected; scope is forced to all_requests.
    "manual_trigger": {
      "on_trigger": ["report", "dump_kv"]
    }
  }
}
